{
  "mcpServers": {
    "figma-mcp-go": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@vkhanhqui/figma-mcp-go@latest"
      ],
      "env": {}
    },
    "figma-mcp-rust": {
      "type": "stdio",
