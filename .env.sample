# Morrow environment template: safe to commit; never add real credentials here.
# Copy to .env.local in the Next.js project root only if that file does not exist.
# If .env.local exists, merge missing entries without replacing its values.
# Proposed integration contract: these are not consumed by the reviewed snapshot.

# REQUIRED for Supabase integration. Use the user's existing hosted project.
# Project URL and publishable key: Supabase Dashboard -> project Connect / API keys.
# URL example: https://your-project-ref.supabase.co
# Use the publishable key (sb_publishable_...), never a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# PROPOSED server-side app-origin setting for auth redirect construction.
# This is Morrow configuration, not a built-in Next.js/Supabase variable.
# Set to the actual origin for each environment; change the port if needed.
# Production must use the real HTTPS origin. Supabase redirect settings are separate.
SITE_URL=http://localhost:3000

# OPTIONAL: only introduce for an explicitly approved privileged server operation.
# Normal sign-in, owner-scoped CRUD and SSR use the publishable key + user session.
# Never prefix this with NEXT_PUBLIC_ or use it to bypass missing ownership rules.
# SUPABASE_SECRET_KEY=

# Google OAuth credentials go in the hosted Supabase Google provider settings.
# No app-level Google secret is required for Supabase-managed redirect sign-in.
# AI provider/model/credentials are intentionally omitted until a provider is chosen.
# Database URLs, database passwords and CLI access tokens are not required for
# normal Supabase SDK access; add tooling configuration only when actually needed.
