# Generated phase output is local unless selected below.
# Do not ignore /references/: canonical original Stitch inputs live there.
/phase-*/*

# Retained source fixtures and reviewed comparisons (not app design targets).
!/phase-2/references/
!/phase-3/comparisons/
!/phase-4/

# Generated raster screenshots are disposable browser output; original Stitch inputs live in /references/.
/phase-2/*.png
/phase-2/*.jpg
/phase-2/*.jpeg
/phase-2/*.webp
/phase-3/*.png
/phase-3/*.jpg
/phase-3/*.jpeg
/phase-3/*.webp
/phase-3/comparisons/*.png
/phase-3/comparisons/*.jpg
/phase-3/comparisons/*.jpeg
/phase-3/comparisons/*.webp
/phase-3/**/*.png
/phase-3/**/*.jpg
/phase-3/**/*.jpeg
/phase-3/**/*.webp
/phase-4/*.png
/phase-4/*.jpg
/phase-4/*.jpeg
/phase-4/*.webp
/phase-4/**/*.png
/phase-4/**/*.jpg
/phase-4/**/*.jpeg
/phase-4/**/*.webp
/stabilization/*.png
/stabilization/*.jpg
/stabilization/*.jpeg
/stabilization/*.webp

# Durable diagnostics and meaningful inspection source.
!/phase-*/*.md
!/phase-*/*.cjs

# Selected non-image evidence cited by maintained reports.
# Add a precise exception here when linking new evidence from a report.
!/phase-2/app-results.json
!/phase-2/app-verified.log
!/phase-2/build-final.log
!/phase-2/correction-focus-styles.json
!/phase-2/lint-final.log
!/phase-2/preflight-cdp-responses.json
!/phase-2/preflight-protocol.log
!/phase-2/regressions.log
!/phase-2/typecheck.log
!/phase-3/dev-indicator-diagnostic.json
!/phase-3/dev-origin-diagnostic.md

# Raw phase verification results referenced by maintained report prose.
!/phase-3/results.json

# Phase 4 measurements and raw results.
!/phase-4/studio-*-measurements.json
!/phase-4/results.json

# Selected stabilization diagnostics and measurements; routine images stay local.
/stabilization/*
!/stabilization/collection-empty-diagnostic.json
!/stabilization/home-rail-motion-samples.json
!/stabilization/home-viewport-measurements.json
